	<subDataset name="Table Dataset 1" uuid="ae80b0d6-f619-4474-829e-bf85ae6d0e5a"/>
	<queryString>
		<![CDATA[SELECT
     nilai_akhir.`id_siswa` AS nilai_akhir_id_siswa,
     nilai_akhir.`nama_siswa` AS nilai_akhir_nama_siswa,
     nilai_akhir.`nilai_akhir_akademik` AS nilai_akhir_akademik,
     nilai_akhir.`nilai_akhir_prestasi` AS nilai_akhir_prestasi,
     nilai_akhir.`nilai_akhir_kehadiran` AS nilai_akhir_kehadiran,
     nilai_akhir.`nilai_akhir_sikap` AS nilai_akhir_sikap,
     nilai_akhir.`nilai_akhir_partisipasi` AS nilai_akhir_partisipasi,
     nilai_akhir.`jumlah_nilai_akhir` AS nilai_akhir_jumlah,
     nilai_akhir.`ranking` AS nilai_akhir_ranking
FROM
     `nilai_akhir` nilai_akhir]]>
	</queryString>
